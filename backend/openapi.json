    "/api/v1/pipelines/runs": {
      "get": {
        "operationId": "list_runs_api_v1_pipelines_runs_get",
        "parameters": [
          {
            "in": "query",
            "name": "pipeline",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 40,
                  "pattern": "^[a-z][a-z0-9_]+$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Pipeline"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunSummaryOut"
