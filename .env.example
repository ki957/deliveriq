# DeliverIQ environment template. Copy to `.env` (git-ignored) and fill in locally.
# Placeholders only. Never commit real values. Settings report missing keys by name, never by value.

# --- Application -------------------------------------------------------------
# local | test | production  (gates MOCK_OTP, fixtures, fault injection, reset-test-data)
APP_ENV=local

# --- PostgreSQL (one password per DB role, DOCKER_DEPLOYMENT_DESIGN.md §6.3) ---
POSTGRES_DB=deliveriq
POSTGRES_SUPERUSER_PASSWORD=change-me
APP_MIGRATOR_PASSWORD=change-me
APP_API_PASSWORD=change-me
WORKER_PASSWORD=change-me
P1_SOP_PASSWORD=change-me
P2_ELT_PASSWORD=change-me
P3_SYNTH_PASSWORD=change-me
RAG_CUSTOMER_PASSWORD=change-me
RAG_KITCHEN_PASSWORD=change-me
RAG_MANAGEMENT_PASSWORD=change-me

# Use URL-safe passwords (letters, digits, - _). Host ports bind to 127.0.0.1 only.
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000
# Build-time UID/GID so bind-mounted files stay owned by your user (run `id -u` / `id -g`).
APP_UID=1000
APP_GID=1000
LOG_LEVEL=INFO

# --- Redis (internal network only; not published) -------------------------------
# Compose sets REDIS_URL for containers; nothing to configure here.

# --- Login (DDR-96). mock = fixed test code 123456, local/test only; production uses disabled.
OTP_ADAPTER=mock
# Secret key for hashing OTPs (min 16 chars). Generate a long random value.
OTP_PEPPER=change-me
# Comma-separated dev origins for cross-origin requests; empty = none (the Vite dev server proxies /api).
CORS_ORIGINS=

# --- AI (RAG_AI_DESIGN.md §17). Model IDs live in backend/config/ai_models.yaml --
AI_ENABLED=false
AI_PROMPT_GUARD_ENABLED=false
AI_FALLBACK_ENABLED=false
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Builder Agent only (Task 15C): fine-grained token, contents + pull requests ---
GITHUB_TOKEN=
